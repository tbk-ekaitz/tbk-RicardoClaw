# === Gmail API (OAuth2 — solo lectura) ===
# No se necesitan credenciales aqui. La autorizacion se gestiona via OAuth:
#   1. Coloca client_secret.json en skills/email-reader/credentials/
#   2. Ejecuta: node skills/email-reader/scripts/oauth-setup.js
#   3. El token se guarda automaticamente en credentials/gmail-token.json
#
# Scope usado: gmail.readonly (Google bloquea cualquier escritura)

# === Ollama (LLM local) ===
OLLAMA_HOST=http://192.168.x.x:11434
# Modelo principal (ligero, rapido)
OLLAMA_MODEL=qwen2.5:7b
# Para tareas complejas, cambiar a:
# OLLAMA_MODEL=qwen2.5:72b
